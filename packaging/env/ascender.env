# Environment of ascender-web and ascender-task, one file for both (read by
# their systemd units; a value here overrides the unit's own). Every
# ASCENDER_* variable is described in the Ascender source, deploy/README.md
# and docs/clustering.md; the ones most installations set are listed here.
# Restart the services after a change.

# The database: a URL, or its parts. The complete single-node package
# (ascender) writes a URL that reaches the local PostgreSQL over its socket
# as the ascender user, with no password.
#ASCENDER_DATABASE_URL=postgres://ascender:password@db.example.com:5432/ascender?sslmode=require
#ASCENDER_DB_HOST=localhost
#ASCENDER_DB_PORT=5432
#ASCENDER_DB_NAME=ascender
#ASCENDER_DB_USER=ascender
#ASCENDER_DB_PASSWORD=
#ASCENDER_DB_SSLMODE=prefer

# The SECRET_KEY encrypts credentials and settings in the database; every
# web and task process of one installation must carry the same one. The
# units read it from /etc/ascender/SECRET_KEY (ASCENDER_SECRET_KEY_FILE).

# Where ascender-web listens, and the certificate it serves. Without a
# certificate it speaks plain HTTP: put a TLS proxy in front, or set
# ASCENDER_MODE=development so the browser accepts the cookies over HTTP.
#ASCENDER_LISTEN=:8070
#ASCENDER_TLS_CERT_FILE=/etc/ascender/tls/server.crt
#ASCENDER_TLS_KEY_FILE=/etc/ascender/tls/server.key
#ASCENDER_ALLOWED_HOSTS=
#ASCENDER_CSRF_TRUSTED_ORIGINS=
#ASCENDER_MODE=production

# When set, the password of the admin account at every start of either
# service (the account is created when it is missing).
#ASCENDER_ADMIN_PASSWORD_FILE=/etc/ascender/ADMIN_PASSWORD

# The task process: this node's name in the cluster (the host name when
# unset), whether it runs jobs (hybrid) or only controls them (control), and
# how many it runs at once.
#ASCENDER_CLUSTER_HOST_ID=
#ASCENDER_NODE_TYPE=hybrid
#ASCENDER_TASK_WORKERS=4
#ASCENDER_LOG_LEVEL=info
